# Local machine settings, read by the repo's tools (tools/dev.py, tools_pc/fxview/fxview.py, ...).
# Copy this file to .env at the repo root and fill it in. .env is ignored by git: never commit it.

# The console's address on the local network, for nxlink (hbmenu, netloader).
SWITCH_IP=192.168.0.2

# The Switch emulator used for the screenshot / capture runs, and the root of its virtual SD card.
SWITCH_EMU_EXE=C:\path\to\switch-emulator.exe
SWITCH_EMU_SD=C:\path\to\switch-emulator\sdcard

# An N64 emulator, for reference captures.
N64_EMU_EXE=C:\path\to\n64-emulator.exe

# Your ROMs, one per region (only the US one is used for now): the .z64 the N64 emulator opens (tools/dev.py n64)
# and the one every tool reads (tools/dev.py tools: modelview, fxview, disasm...). The native builds need the ROM
# in their data/ folder: `tools/dev.py win|linux` copies N64_ROM_US there as ge007.ntsc-final.z64; when you run
# the exe by hand, copy it yourself to <build dir>/data/ge007.ntsc-final.z64.
N64_ROM_US=C:\path	o\GoldenEye 007 (USA).z64
N64_ROM_JP=
N64_ROM_PAL=

# The Docker image the Switch build runs in. Unset: the published, digest-pinned image (pulled on first use).
# After `docker compose build image-local` (testing a Dockerfile.build change) use the local one:
# DOCKER_IMAGE=local/project-dam-build:latest

# modelview: the character export to read (the characters folder or the export folder above it).
# Unset: tools_pc/modelview/data/export, written by `python tools_pc/modelview/modelview.py export`.
# MODELVIEW_EXPORT=C:\path	o\exports

# modelview: the game folder holding texturepacks/ and mods/ (the mod and texture-pack choices). Unset: a build folder of this checkout.
# MODELVIEW_GAME=C:\path\to\game

# A Windows g++ (MinGW-w64) the viewers build with (menuview, modelview).
# Optional when MSYS2 is installed in C:\msys64.
SEAVIEW_GXX=C:\path\to\mingw64\bin\g++.exe
